# Node Environment
NODE_ENV=development

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://admin:password123@localhost:27017/islamic_community_hub?authSource=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# File Upload
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads

# UPI Configuration
SUPER_ADMIN_UPI_ID=superadmin@upi
REGISTRATION_FEE_AMOUNT=5000
REGISTRATION_FEE_CURRENCY=INR

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# API Documentation
API_DOCS_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
