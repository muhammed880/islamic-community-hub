{
  "name": "islamic-community-hub",
  "version": "1.0.0",
  "description": "Islamic Community Hub - Masjid Management Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest",
    "lint": "eslint .",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "start-backend": "cd backend && npm run dev",
    "start-frontend": "cd frontend && npm start",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "islamic",
    "community",
    "masjid",
    "nikah",
    "matrimony",
    "jobs",
    "zakat",
    "donations",
    "quran",
    "imam"
  ],
  "author": "muhammed8803",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/muhammed8803/islamic-community-hub.git"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "dotenv": "^16.0.3",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-validator": "^7.0.0",
    "multer": "^1.4.5",
    "aws-sdk": "^2.1300.0",
    "razorpay": "^2.8.2",
    "axios": "^1.3.0",
    "nodemailer": "^6.9.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.36.0"
  }
}
