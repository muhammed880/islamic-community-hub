{
  _id: ObjectId,
  sessionId: String (unique),
  masjid: ObjectId (ref: masjids),
  imam: ObjectId (ref: users - masjid_authority),
  
  // Session Details
  title: String,
  description: String,
  topic: String,
  
  // Schedule
  scheduledDate: Date,
  scheduledTime: String, // HH:MM format
  durationMinutes: Number,
  
  // Agora SDK Details
  channelName: String,
  channelToken: String,
  
  // Participants
  maxParticipants: Number,
  participants: [
    {
      userId: ObjectId (ref: users),
      joinedAt: Date,
      leftAt: Date
    }
  ],
  
  // Questions
  questions: [
    {
      questionId: ObjectId,
      userId: ObjectId,
      question: String,
      askedAt: Date,
      answer: String,
      answeredAt: Date,
      isAnswered: Boolean
    }
  ],
  
  // Recording
  recordingUrl: String,
  recordingDuration: Number,
  
  // Status
  status: Enum['scheduled', 'live', 'completed', 'cancelled'],
  actualStartTime: Date,
  actualEndTime: Date,
  
  // Timestamps
  createdAt: Date,
  updatedAt: Date
}
