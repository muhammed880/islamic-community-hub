{
  _id: ObjectId,
  jobTitle: String,
  jobDescription: String,
  masjid: ObjectId (ref: masjids),
  
  // Job Details
  jobType: Enum['full_time', 'part_time', 'contract', 'volunteer'],
  salaryRange: {
    minSalary: Number,
    maxSalary: Number,
    currency: String
  },
  
  // Location
  location: {
    city: String,
    state: String,
    country: String
  },
  
  // Requirements
  qualifications: [String],
  experience: Number, // in years
  skills: [String],
  
  // Status
  status: Enum['active', 'closed', 'filled'],
  postedDate: Date,
  closingDate: Date,
  
  // Applicants
  applicants: [
    {
      userId: ObjectId (ref: users),
      appliedDate: Date,
      status: Enum['pending', 'shortlisted', 'rejected', 'selected']
    }
  ],
  
  // Timestamps
  createdAt: Date,
  updatedAt: Date
}
