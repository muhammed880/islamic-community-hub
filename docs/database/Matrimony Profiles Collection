{
  _id: ObjectId,
  profileId: String (unique),
  userId: ObjectId (ref: users),
  masjid: ObjectId (ref: masjids),
  
  // Personal Information
  fullName: String,
  dateOfBirth: Date,
  gender: Enum['male', 'female'],
  phone: String,
  email: String,
  profilePhoto: String (URL),
  
  // Physical Attributes
  height: String,
  complexion: String,
  bodyType: String,
  
  // Education & Career
  education: String,
  occupation: String,
  income: Number,
  incomeCurrency: String,
  
  // Family Background
  fatherName: String,
  motherName: String,
  siblings: Number,
  familyType: Enum['nuclear', 'joint'],
  caste: String,
  
  // Preferences
  lookingFor: String,
  agePreference: {
    minAge: Number,
    maxAge: Number
  },
  locationPreference: [String],
  
  // Additional Info
  hobbies: [String],
  languages: [String],
  religiousBackground: String,
  
  // Status
  status: Enum['active', 'inactive', 'verified'],
  verifiedBy: ObjectId (ref: users - super_admin),
  
  // Interactions
  views: [
    {
      userId: ObjectId,
      viewDate: Date
    }
  ],
  interests: [
    {
      userId: ObjectId,
      interestDate: Date,
      status: Enum['pending', 'accepted', 'rejected']
    }
  ],
  
  // Timestamps
  createdAt: Date,
  updatedAt: Date
}
