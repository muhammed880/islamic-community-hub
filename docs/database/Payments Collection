{
  _id: ObjectId,
  paymentId: String (unique),
  
  // Customer Info
  userId: ObjectId (ref: users),
  masjid: ObjectId (ref: masjids),
  email: String,
  phone: String,
  
  // Payment Details
  amount: Number,
  currency: String,
  
  // Razorpay Details
  razorpayOrderId: String,
  razorpayPaymentId: String,
  razorpaySignature: String,
  
  // Purpose
  paymentFor: Enum['registration', 'renewal', 'donation', 'zakat'],
  
  // Status
  status: Enum['created', 'authorized', 'captured', 'failed', 'refunded'],
  failureReason: String,
  
  // Timestamps
  createdAt: Date,
  authorizedAt: Date,
  capturedAt: Date,
  updatedAt: Date
}
