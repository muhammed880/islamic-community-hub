{
  _id: ObjectId,
  donorId: ObjectId (ref: users),
  masjid: ObjectId (ref: masjids),
  
  // Donation Details
  amount: Number,
  currency: String,
  donationType: Enum['zakat', 'sadaqah', 'general_donation', 'specific_cause'],
  
  // For Specific Causes
  causeType: Enum['quran_classes', 'ask_imam', 'building', 'events', 'charity'],
  specificCause: String,
  needyPerson: ObjectId (ref: needy_persons), // if zakat donation
  
  // Payment Details
  paymentMethod: Enum['upi', 'bank_transfer', 'card'],
  transactionId: String,
  
  // Status
  status: Enum['pending', 'completed', 'failed', 'refunded'],
  
  // Timestamps
  donatedAt: Date,
  completedAt: Date,
  createdAt: Date,
  updatedAt: Date
}
