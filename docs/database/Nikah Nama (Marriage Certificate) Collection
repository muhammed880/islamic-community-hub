{
  _id: ObjectId,
  certificateNumber: String (unique),
  masjid: ObjectId (ref: masjids),
  
  // Groom Details
  groom: {
    name: String,
    email: String,
    phone: String,
    dateOfBirth: Date,
    address: String,
    guardianName: String,
    guardianRelation: String
  },
  
  // Bride Details
  bride: {
    name: String,
    email: String,
    phone: String,
    dateOfBirth: Date,
    address: String,
    guardianName: String,
    guardianRelation: String
  },
  
  // Marriage Details
  marriageDate: Date,
  mahr: Number,
  maharCurrency: String,
  witnesses: [
    {
      name: String,
      phone: String
    }
  ],
  
  // Imam & Registrar
  imam: String,
  registrar: ObjectId (ref: users),
  
  // Status & Verification
  status: Enum['pending', 'registered', 'verified'],
  verifiedBy: ObjectId (ref: users - super_admin),
  verificationDate: Date,
  
  // Documents
  certificatePDF: String (URL),
  
  // Timestamps
  registrationDate: Date,
  createdAt: Date,
  updatedAt: Date
}
